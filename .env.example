# Tastytrade OAuth Credentials
TASTYTRADE_CLIENT_SECRET=your_client_secret
TASTYTRADE_REFRESH_TOKEN=your_refresh_token
TASTY_ACCOUNT_NUMBER=your_account_number  # Optional: specific account to use
TASTYTRADE_IS_TEST=false

# Private runtime output (defaults to the project directory when unset)
TASTY_COACH_PRIVATE_DATA_ROOT=/Users/office/Private/ProjectsData/trading/tasty-coach

# Scanner Configuration
IVR_THRESHOLD=25
LOG_LEVEL=INFO

# Optional Settings
CACHE_DURATION=300
MAX_RETRIES=3
